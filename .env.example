# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# Resend sends every email the site sends and keeps the newsletter list. No database is used.
# A "Full access" key lets the site save subscribers in Resend Contacts by itself. A "Sending
# access" key works too: new subscribers are then emailed to CONTACT_INBOX to add by hand.
RESEND_API_KEY=

# Sender. The domain must be verified in Resend, e.g. Toolveld <hello@toolveld.co.za>.
# For testing before that, Toolveld <onboarding@resend.dev> delivers to your own Resend email only.
EMAIL_FROM=

# Inbox for contact messages, new reviews and subscriber notices. Defaults to hello@ the site domain.
CONTACT_INBOX=

# Long random string that signs newsletter confirm and unsubscribe links. Keep it the same everywhere.
NEWSLETTER_SECRET=

# Optional: Resend segment ID that confirmed subscribers are added to.
RESEND_SEGMENT_ID=

# Optional: public URL of the site, if it is not the SITE_DOMAIN in lib/site.ts.
# NEXT_PUBLIC_SITE_URL=https://toolveld.co.za

# Not used. The site runs on its bundled data and Resend. Only the optional /admin area and
# reader review publishing would need a Supabase project.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
