# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public URL of the site, used for canonical links, the sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://toolveld.co.za

# Supabase project URL and anon key (Project settings > API). Leave empty to run on the bundled dataset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server only. Used by the seed and create-admin scripts and never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The single administrator, created by `npm run create-admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: sends newsletter confirmation emails through Resend.
RESEND_API_KEY=
EMAIL_FROM=
